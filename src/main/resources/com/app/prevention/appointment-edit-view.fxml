<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="300.0" minWidth="500.0" prefHeight="300.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.prevention.controller.AppointmentEditController">
    <BorderPane minHeight="300.0" minWidth="500.0" prefHeight="300.0" prefWidth="500.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <center>
            <VBox spacing="5.0" BorderPane.alignment="CENTER">
                <Label text="Paciente:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="patientField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dateField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <HBox spacing="5.0">
                    <CheckBox fx:id="transportField" onAction="#onClickTransportField"/>

                    <Label text="Precisa de Transporte?"/>
                </HBox>
                <HBox fx:id="localityHorizontalBox" spacing="5.0" visible="false">
                    <VBox prefWidth="250.0">
                        <Label text="Local:"/>
                        <TextField fx:id="localityField"/>
                    </VBox>
                    <VBox prefWidth="250.0">
                        <Label text="Periodo:"/>
                        <ComboBox fx:id="periodField" prefWidth="250.0"/>
                    </VBox>
                </HBox>
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            </VBox>
        </center>
      <bottom>

             <HBox prefHeight="50.0" prefWidth="200.0" spacing="5.0" BorderPane.alignment="CENTER">
                 <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                 </padding>
                 <Button minWidth="100.0" mnemonicParsing="false" onAction="#onClickSaveButton" text="Salvar" />
                 <Button minWidth="100.0" mnemonicParsing="false" onAction="#onClickCancelButton" text="Cancelar" />
             </HBox>
      </bottom>
    </BorderPane>
</AnchorPane>
